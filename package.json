{
  "name": "product-change-agent-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "AI Production Change Agent monorepo",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:web": "pnpm --filter @pca/web test",
    "test:e2e": "node scripts/run-e2e.mjs",
    "build": "pnpm -r --if-present build",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@pca/contracts": "workspace:*",
    "@pca/domain": "workspace:*",
    "@pca/fixtures": "workspace:*",
    "@pca/test-support": "workspace:*",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "globals": "^17.12.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
