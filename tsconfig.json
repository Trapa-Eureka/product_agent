{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "packages/**/src/**/*.ts",
    "packages/**/test/**/*.ts",
    "apps/**/src/**/*.ts",
    "apps/**/test/**/*.ts",
    "apps/**/e2e/**/*.ts",
    "tests/**/*.ts",
    "e2e/**/*.ts",
    "*.config.ts"
  ],
  "exclude": ["**/node_modules", "**/dist", "apps/web/**"]
}
